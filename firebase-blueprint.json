{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a registered user on our platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID from Firebase Auth." },
        "email": { "type": "string", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The human display name." },
        "photoURL": { "type": "string", "description": "The profile photo URL." },
        "isSimulationUser": { "type": "boolean", "description": "True if logged in via simulation/virtual login." },
        "attendanceCount": { "type": "integer", "description": "Number of attendance stamps." },
        "rewardCode": { "type": "string", "description": "The earned reward coupon code if any." },
        "isRewardClaimed": { "type": "boolean", "description": "True if reward coupon code is claimed." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp of user creation." }
      },
      "required": ["uid", "createdAt"]
    },
    "Partner": {
      "title": "Partner",
      "description": "A customized relationship counterpart added by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique partner identifier." },
        "nickname": { "type": "string", "description": "The designated nickname for the partner." },
        "relationship": { "type": "string", "description": "The status stage." },
        "lastContact": { "type": "string", "description": "Last communication timeline description." },
        "contactStatus": { "type": "string", "description": "Further details or status description." },
        "temperatureHistory": { "type": "array", "description": "The array list log of thermometer readings." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." }
      },
      "required": ["id", "nickname", "relationship", "createdAt"]
    },
    "Reading": {
      "title": "Reading",
      "description": "Tarot reading interpretation card saves.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The reading instance identifier." },
        "question": { "type": "string", "description": "The primary menu title or query topic." },
        "partnerNickname": { "type": "string" },
        "relationship": { "type": "string" },
        "cards": { "type": "array", "description": "Detailed selected card descriptions." },
        "readingResult": { "type": "object", "description": "Dynamic structural nested response mappings." },
        "productType": { "type": "string" },
        "isPaid": { "type": "boolean" },
        "dateTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "question", "cards", "readingResult", "isPaid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Primary user configuration node."
    },
    "/users/{userId}/partners/{partnerId}": {
      "schema": "Partner",
      "description": "Individual relational counterpart subcollection."
    },
    "/users/{userId}/readings/{readingId}": {
      "schema": "Reading",
      "description": "Tarot Reading saves of the user."
    }
  }
}
